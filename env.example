# Copy to `.env` and fill in. Never commit the real `.env`.
# (This template is named `env.example` — rename the copy to `.env`.)

# --- infrastructure (Phase 5+) --------------------------------------------
# Master key for AES-GCM credential sealing. Generate once, keep secret:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_SECRET_KEY=

# First-run password for the web panel (Argon2-hashed on first use).
ADMIN_PASSWORD=

# --- network defaults ------------------------------------------------------
# BOT_USER_AGENT=Mozilla/5.0 (...)   # override the default browser-like UA
# BOT_HTTP_TIMEOUT=20
# LOG_LEVEL=info

# --- Phase 1 smoke test only ----------------------------------------------
# Credentials for a single throwaway account, used by scripts/smoke.py.
# These are NOT how the running bot stores credentials (that is the encrypted
# DB); they exist only to exercise the game client from the command line.
BLAULICHT_EMAIL=
BLAULICHT_PASSWORD=
